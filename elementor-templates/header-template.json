        "settings": {
          "html": "<div class=\"axela-ticker-outer\">\n  <div class=\"axela-ticker-bar\">\n    <div class=\"axela-ticker-badge\">\n      <span class=\"ticker-dot\"></span>\n      <span class=\"ticker-badge-text\">LIVE MARKETS</span>\n      <span class=\"ticker-badge-pipe\">|</span>\n    </div>\n    <div class=\"axela-ticker-marquee-wrap\">\n      <div class=\"axela-ticker-marquee-inner\">\n        <span class=\"tick-group\">\n          <span class=\"t-prov\">PLATTS</span> <span class=\"t-name\">LNG JKM</span> <span class=\"t-val-dn\">13.188</span> <span class=\"t-unit\">$/MMBtu</span> <span class=\"t-chg-dn\">\u25bc 2.32%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">ICE</span> <span class=\"t-name\">TTF GAS</span> <span class=\"t-val-up\">11.383</span> <span class=\"t-unit\">\u20ac/MWh</span> <span class=\"t-chg-up\">\u25b2 1.46%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">NYMEX</span> <span class=\"t-name\">HENRY HUB</span> <span class=\"t-val-dn\">1.877</span> <span class=\"t-unit\">$/MMBtu</span> <span class=\"t-chg-dn\">\u25bc 20.47%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">ARGUS</span> <span class=\"t-name\">RB COAL (API 2)</span> <span class=\"t-val-dn\">98.94</span> <span class=\"t-unit\">$/MT</span> <span class=\"t-chg-dn\">\u25bc 5.47%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">PLATTS</span> <span class=\"t-name\">IRON ORE 62% FE</span> <span class=\"t-val-up\">121.28</span> <span class=\"t-unit\">$/dmt</span> <span class=\"t-chg-up\">\u25b2 3.30%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">PLATTS</span> <span class=\"t-name\">DUBAI FATEH</span> <span class=\"t-val-dn\">77.83</span> <span class=\"t-unit\">$/bbl</span> <span class=\"t-chg-dn\">\u25bc 4.87%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">PLATTS</span> <span class=\"t-name\">DATED BRENT</span> <span class=\"t-val-up\">82.50</span> <span class=\"t-unit\">$/bbl</span> <span class=\"t-chg-up\">\u25b2 0.06%</span>\n          <span class=\"t-pipe\">|</span>\n        </span>\n        <span class=\"tick-group\">\n          <span class=\"t-prov\">PLATTS</span> <span class=\"t-name\">LNG JKM</span> <span class=\"t-val-dn\">13.188</span> <span class=\"t-unit\">$/MMBtu</span> <span class=\"t-chg-dn\">\u25bc 2.32%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">ICE</span> <span class=\"t-name\">TTF GAS</span> <span class=\"t-val-up\">11.383</span> <span class=\"t-unit\">\u20ac/MWh</span> <span class=\"t-chg-up\">\u25b2 1.46%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">NYMEX</span> <span class=\"t-name\">HENRY HUB</span> <span class=\"t-val-dn\">1.877</span> <span class=\"t-unit\">$/MMBtu</span> <span class=\"t-chg-dn\">\u25bc 20.47%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">ARGUS</span> <span class=\"t-name\">RB COAL (API 2)</span> <span class=\"t-val-dn\">98.94</span> <span class=\"t-unit\">$/MT</span> <span class=\"t-chg-dn\">\u25bc 5.47%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">PLATTS</span> <span class=\"t-name\">IRON ORE 62% FE</span> <span class=\"t-val-up\">121.28</span> <span class=\"t-unit\">$/dmt</span> <span class=\"t-chg-up\">\u25b2 3.30%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">PLATTS</span> <span class=\"t-name\">DUBAI FATEH</span> <span class=\"t-val-dn\">77.83</span> <span class=\"t-unit\">$/bbl</span> <span class=\"t-chg-dn\">\u25bc 4.87%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">PLATTS</span> <span class=\"t-name\">DATED BRENT</span> <span class=\"t-val-up\">82.50</span> <span class=\"t-unit\">$/bbl</span> <span class=\"t-chg-up\">\u25b2 0.06%</span>\n          <span class=\"t-pipe\">|</span>\n        </span>\n      </div>\n    </div>\n    <div class=\"axela-ticker-clock\">\n      <span class=\"clock-pipe\">|</span>\n      <span id=\"axela-live-clock\">01:36 AM GMT+6</span>\n    </div>\n  </div>\n</div>\n\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n\n/* Ticker Outer & Centered Inner */\n.axela-ticker-outer {\n  width: 100% !important;\n  background: #04070C !important;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;\n  display: flex !important;\n  justify-content: center !important;\n  align-items: center !important;\n}\n\n.axela-ticker-bar {\n  max-width: 1360px !important;\n  width: 100% !important;\n  height: 32px !important;\n  line-height: 32px !important;\n  margin: 0 auto !important;\n  display: flex !important;\n  flex-direction: row !important;\n  flex-wrap: nowrap !important;\n  align-items: center !important;\n  justify-content: space-between !important;\n  padding: 0 10px !important;\n  box-sizing: border-box !important;\n  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;\n  font-size: 11px !important;\n  overflow: hidden !important;\n  white-space: nowrap !important;\n}\n\n.axela-ticker-badge {\n  flex-shrink: 0 !important;\n  display: inline-flex !important;\n  align-items: center !important;\n  gap: 6px !important;\n  padding: 0 10px 0 0 !important;\n  height: 32px !important;\n  background: #04070C !important;\n  z-index: 5 !important;\n  white-space: nowrap !important;\n}\n\n.ticker-dot {\n  width: 6px !important;\n  height: 6px !important;\n  border-radius: 50% !important;\n  background: #1ABC9C !important;\n  box-shadow: 0 0 6px #1ABC9C !important;\n  display: inline-block !important;\n  animation: axelaPulseDot 2s infinite ease-in-out !important;\n}\n\n@keyframes axelaPulseDot {\n  0% { opacity: 1; transform: scale(1); }\n  50% { opacity: 0.35; transform: scale(0.85); }\n  100% { opacity: 1; transform: scale(1); }\n}\n\n.ticker-badge-text {\n  color: #1ABC9C !important;\n  font-weight: 700 !important;\n  letter-spacing: 0.08em !important;\n  font-size: 10.5px !important;\n}\n\n.ticker-badge-pipe {\n  color: rgba(255, 255, 255, 0.18) !important;\n  margin-left: 8px !important;\n}\n\n.axela-ticker-marquee-wrap {\n  flex: 1 1 auto !important;\n  overflow: hidden !important;\n  white-space: nowrap !important;\n  height: 32px !important;\n  display: flex !important;\n  align-items: center !important;\n  mask-image: linear-gradient(to right, transparent, black 15px, black calc(100% - 15px), transparent);\n  -webkit-mask-image: linear-gradient(to right, transparent, black 15px, black calc(100% - 15px), transparent);\n}\n\n.axela-ticker-marquee-inner {\n  display: inline-flex !important;\n  align-items: center !important;\n  white-space: nowrap !important;\n  animation: axelaMarqueeLoop 36s linear infinite !important;\n}\n\n.axela-ticker-marquee-inner:hover {\n  animation-play-state: paused !important;\n}\n\n@keyframes axelaMarqueeLoop {\n  0% { transform: translateX(0); }\n  100% { transform: translateX(-50%); }\n}\n\n.tick-group {\n  display: inline-flex !important;\n  align-items: center !important;\n  white-space: nowrap !important;\n}\n\n.t-prov {\n  color: #5A7F87 !important;\n  font-size: 10.5px !important;\n  font-weight: 600 !important;\n  margin-right: 5px !important;\n}\n\n.t-name {\n  color: #FFFFFF !important;\n  font-weight: 700 !important;\n  font-size: 11px !important;\n  letter-spacing: 0.02em !important;\n  margin-right: 6px !important;\n}\n\n.t-val-dn {\n  color: #EF4444 !important;\n  font-weight: 700 !important;\n  margin-right: 4px !important;\n}\n\n.t-val-up {\n  color: #1ABC9C !important;\n  font-weight: 700 !important;\n  margin-right: 4px !important;\n}\n\n.t-unit {\n  color: #64748B !important;\n  font-size: 10px !important;\n  margin-right: 5px !important;\n}\n\n.t-chg-dn {\n  color: #EF4444 !important;\n  font-weight: 700 !important;\n  font-size: 10.5px !important;\n}\n\n.t-chg-up {\n  color: #1ABC9C !important;\n  font-weight: 700 !important;\n  font-size: 10.5px !important;\n}\n\n.t-pipe {\n  color: rgba(255, 255, 255, 0.18) !important;\n  margin: 0 14px !important;\n}\n\n.axela-ticker-clock {\n  flex-shrink: 0 !important;\n  display: inline-flex !important;\n  align-items: center !important;\n  padding: 0 0 0 10px !important;\n  height: 32px !important;\n  background: #04070C !important;\n  color: #CBD5E1 !important;\n  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;\n  font-size: 11px !important;\n  font-weight: 600 !important;\n  letter-spacing: 0.04em !important;\n  z-index: 5 !important;\n  white-space: nowrap !important;\n}\n\n.clock-pipe {\n  color: rgba(255, 255, 255, 0.18) !important;\n  margin-right: 10px !important;\n}\n\n/* ==========================================================================\n   HEADER GRID BALANCE: 1360px Centered Grid Alignment\n   ========================================================================== */\n.axela-sticky-header,\n.elementor-element-hdr_container_main {\n  width: 100% !important;\n  display: flex !important;\n  justify-content: center !important;\n  align-items: center !important;\n  padding: 0 !important;\n  background-color: rgba(7, 11, 17, 0.95) !important;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;\n  position: sticky !important;\n  top: 0 !important;\n  z-index: 99999 !important;\n  backdrop-filter: blur(16px) !important;\n  -webkit-backdrop-filter: blur(16px) !important;\n}\n\n.axela-sticky-header > .e-con-inner,\n.elementor-element-hdr_container_main > .e-con-inner {\n  max-width: 1360px !important;\n  width: 100% !important;\n  margin: 0 auto !important;\n  padding: 8px 10px !important;\n  display: flex !important;\n  flex-direction: row !important;\n  flex-wrap: nowrap !important;\n  justify-content: space-between !important;\n  align-items: center !important;\n  box-sizing: border-box !important;\n}\n\n.elementor-element-hdr_logo_wrap {\n  flex: 0 0 auto !important;\n  width: auto !important;\n}\n\n.elementor-element-hdr_nav_wrap,\n.elementor-element-hdr_nav_wrap > .e-con-inner {\n  display: flex !important;\n  flex-direction: row !important;\n  flex-wrap: nowrap !important;\n  justify-content: center !important;\n  align-items: center !important;\n  flex: 1 1 auto !important;\n  width: auto !important;\n  max-width: none !important;\n}\n\n/* Navigation Typography & Tracking */\n.elementor-element-hdr_nav_menu,\n.elementor-nav-menu--main,\n.elementor-nav-menu--layout-horizontal,\nul.elementor-nav-menu {\n  display: flex !important;\n  flex-direction: row !important;\n  flex-wrap: nowrap !important;\n  white-space: nowrap !important;\n  justify-content: center !important;\n  align-items: center !important;\n  width: auto !important;\n  max-width: none !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  list-style: none !important;\n}\n\n.elementor-nav-menu--main li,\nul.elementor-nav-menu li {\n  display: inline-flex !important;\n  flex-shrink: 0 !important;\n  white-space: nowrap !important;\n  list-style: none !important;\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\n.elementor-nav-menu--main a.elementor-item,\nul.elementor-nav-menu a.elementor-item {\n  display: inline-block !important;\n  white-space: nowrap !important;\n  padding: 6px 9px !important;\n  font-size: 12.5px !important;\n  font-weight: 500 !important;\n  letter-spacing: 0.04em !important;\n  color: #CBD5E1 !important;\n  transition: color 0.2s ease !important;\n  text-decoration: none !important;\n}\n\n.elementor-nav-menu--main a.elementor-item:hover,\n.elementor-nav-menu--main a.elementor-item.elementor-item-active {\n  color: #FFFFFF !important;\n}\n\n.elementor-element-hdr_cta_wrap {\n  flex: 0 0 auto !important;\n  width: auto !important;\n}\n</style>\n\n<script>\n(function() {\n  function updateAxelaClock() {\n    var el = document.getElementById('axela-live-clock');\n    if (!el) return;\n    var now = new Date();\n    var utc = now.getTime() + (now.getTimezoneOffset() * 60000);\n    var bd = new Date(utc + (3600000 * 6));\n    var h = bd.getHours();\n    var m = String(bd.getMinutes()).padStart(2, '0');\n    var ampm = h >= 12 ? 'PM' : 'AM';\n    h = h % 12;\n    h = h ? String(h).padStart(2, '0') : '12';\n    el.textContent = h + ':' + m + ' ' + ampm + ' GMT+6';\n  }\n  updateAxelaClock();\n  setInterval(updateAxelaClock, 1000);\n})();\n</script>"
        },

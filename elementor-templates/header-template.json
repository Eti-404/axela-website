        "id": "hdr_full_nav_widget",
        "elType": "widget",
        "settings": {
          "html": "<div class=\"axela-header-bar\">\n  <div class=\"axela-header-inner\">\n    <!-- Brand Logo -->\n    <a href=\"#home\" class=\"axela-brand-logo\">\n      <img src=\"https://axelaglobal.com/wp-content/uploads/2026/10/axela-logo-dark.webp\" alt=\"AXELA LTD.\" class=\"axela-logo-img\">\n    </a>\n\n    <!-- Desktop Single-Line Navigation (min-width: 992px) -->\n    <nav class=\"axela-desktop-nav\">\n      <a href=\"#home\" class=\"nav-item\">Home</a>\n      <a href=\"#about\" class=\"nav-item\">About Us</a>\n      <a href=\"#services\" class=\"nav-item\">Services</a>\n      <a href=\"#products\" class=\"nav-item\">Products</a>\n      <a href=\"#approach\" class=\"nav-item\">Approach</a>\n      <a href=\"#investment\" class=\"nav-item\">Investment</a>\n      <a href=\"#ethics\" class=\"nav-item\">Ethics</a>\n      <a href=\"#contact\" class=\"nav-item\">Contact</a>\n    </nav>\n\n    <!-- Desktop CTA Button -->\n    <div class=\"axela-desktop-cta\">\n      <a href=\"#enquiry\" class=\"axela-header-btn\">TRADE ENQUIRY</a>\n    </div>\n\n    <!-- Mobile Hamburger Toggle Button (max-width: 991px) -->\n    <button type=\"button\" class=\"axela-hamburger-btn\" id=\"axelaHamburgerBtn\" aria-label=\"Open Navigation Menu\">\n      <span class=\"ham-line\"></span>\n      <span class=\"ham-line\"></span>\n      <span class=\"ham-line\"></span>\n    </button>\n  </div>\n</div>\n\n<!-- Mobile Off-Canvas Drawer & Overlay -->\n<div class=\"axela-drawer-overlay\" id=\"axelaDrawerOverlay\"></div>\n<div class=\"axela-drawer-panel\" id=\"axelaDrawerPanel\">\n  <div class=\"drawer-header\">\n    <img src=\"https://axelaglobal.com/wp-content/uploads/2026/10/axela-logo-dark.webp\" alt=\"AXELA LTD.\" class=\"drawer-logo\">\n    <button type=\"button\" class=\"drawer-close-btn\" id=\"axelaDrawerCloseBtn\" aria-label=\"Close Navigation Menu\">&times;</button>\n  </div>\n  \n  <div class=\"drawer-nav-list\">\n    <a href=\"#home\" class=\"drawer-nav-item\">Home</a>\n    <a href=\"#about\" class=\"drawer-nav-item\">About Us</a>\n    <a href=\"#services\" class=\"drawer-nav-item\">Our Services</a>\n    <a href=\"#products\" class=\"drawer-nav-item\">Trading Categories</a>\n    <a href=\"#approach\" class=\"drawer-nav-item\">Working Approach</a>\n    <a href=\"#investment\" class=\"drawer-nav-item\">Investment Opportunities</a>\n    <a href=\"#ethics\" class=\"drawer-nav-item\">Ethics &amp; Compliance</a>\n    <a href=\"#contact\" class=\"drawer-nav-item\">Contact Us</a>\n  </div>\n\n  <div class=\"drawer-footer\">\n    <a href=\"#enquiry\" class=\"drawer-cta-btn\">SUBMIT A TRADE ENQUIRY</a>\n  </div>\n</div>\n\n<style>\n/* Header Bar Outer & 1400px Max-Width Inner */\n.axela-header-bar {\n  width: 100% !important;\n  background-color: rgba(7, 11, 17, 0.96) !important;\n  backdrop-filter: blur(16px) !important;\n  -webkit-backdrop-filter: blur(16px) !important;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;\n  position: sticky !important;\n  top: 0 !important;\n  z-index: 99999 !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  box-sizing: border-box !important;\n}\n\n.axela-header-inner {\n  max-width: 1400px !important;\n  width: 100% !important;\n  margin: 0 auto !important;\n  padding: 10px 24px !important;\n  display: flex !important;\n  flex-direction: row !important;\n  flex-wrap: nowrap !important;\n  justify-content: space-between !important;\n  align-items: center !important;\n  box-sizing: border-box !important;\n}\n\n/* Brand Logo */\n.axela-brand-logo {\n  display: inline-flex !important;\n  align-items: center !important;\n  text-decoration: none !important;\n  flex-shrink: 0 !important;\n}\n\n.axela-logo-img {\n  width: 135px !important;\n  height: auto !important;\n  display: block !important;\n}\n\n/* Desktop Single-Line Navigation */\n.axela-desktop-nav {\n  display: flex !important;\n  flex-direction: row !important;\n  flex-wrap: nowrap !important;\n  white-space: nowrap !important;\n  align-items: center !important;\n  justify-content: center !important;\n  gap: 2px !important;\n  margin: 0 16px !important;\n  flex: 1 1 auto !important;\n}\n\n.axela-desktop-nav .nav-item {\n  color: #CBD5E1 !important;\n  font-family: 'Plus Jakarta Sans', -apple-system, sans-serif !important;\n  font-size: 12.5px !important;\n  font-weight: 500 !important;\n  letter-spacing: 0.04em !important;\n  padding: 6px 9px !important;\n  text-decoration: none !important;\n  white-space: nowrap !important;\n  flex-shrink: 0 !important;\n  transition: all 0.2s ease !important;\n  position: relative !important;\n}\n\n.axela-desktop-nav .nav-item:hover {\n  color: #FFFFFF !important;\n}\n\n.axela-desktop-nav .nav-item:after {\n  content: '' !important;\n  position: absolute !important;\n  bottom: 0 !important;\n  left: 50% !important;\n  width: 0 !important;\n  height: 2px !important;\n  background: #168B8D !important;\n  transition: all 0.25s ease !important;\n  transform: translateX(-50%) !important;\n}\n\n.axela-desktop-nav .nav-item:hover:after {\n  width: 80% !important;\n}\n\n/* Desktop CTA */\n.axela-desktop-cta {\n  flex-shrink: 0 !important;\n  display: flex !important;\n  align-items: center !important;\n}\n\n.axela-header-btn {\n  background: #168B8D !important;\n  color: #FFFFFF !important;\n  border: 1px solid rgba(45, 212, 191, 0.45) !important;\n  border-radius: 3px !important;\n  font-family: 'Plus Jakarta Sans', -apple-system, sans-serif !important;\n  font-size: 11.5px !important;\n  font-weight: 700 !important;\n  letter-spacing: 0.08em !important;\n  text-transform: uppercase !important;\n  text-decoration: none !important;\n  padding: 8px 18px !important;\n  white-space: nowrap !important;\n  transition: all 0.25s ease !important;\n}\n\n.axela-header-btn:hover {\n  background: #1A9D9F !important;\n  box-shadow: 0 0 14px rgba(22, 139, 141, 0.45) !important;\n}\n\n/* Mobile Hamburger Button (Default hidden on desktop) */\n.axela-hamburger-btn {\n  display: none !important;\n  background: transparent !important;\n  border: none !important;\n  cursor: pointer !important;\n  padding: 8px !important;\n  flex-direction: column !important;\n  justify-content: center !important;\n  gap: 5px !important;\n  z-index: 100 !important;\n}\n\n.axela-hamburger-btn .ham-line {\n  display: block !important;\n  width: 24px !important;\n  height: 2px !important;\n  background-color: #CBD5E1 !important;\n  border-radius: 2px !important;\n  transition: all 0.25s ease !important;\n}\n\n/* Mobile Off-Canvas Drawer & Overlay */\n.axela-drawer-overlay {\n  display: none;\n  position: fixed !important;\n  top: 0 !important;\n  left: 0 !important;\n  width: 100vw !important;\n  height: 100vh !important;\n  background: rgba(0, 0, 0, 0.75) !important;\n  backdrop-filter: blur(4px) !important;\n  z-index: 999998 !important;\n  opacity: 0;\n  transition: opacity 0.3s ease !important;\n}\n\n.axela-drawer-overlay.active {\n  display: block !important;\n  opacity: 1 !important;\n}\n\n.axela-drawer-panel {\n  position: fixed !important;\n  top: 0 !important;\n  right: -320px !important;\n  width: 290px !important;\n  height: 100vh !important;\n  background: #070B11 !important;\n  border-left: 1px solid rgba(255, 255, 255, 0.1) !important;\n  box-shadow: -10px 0 30px rgba(0, 0, 0, 0.8) !important;\n  z-index: 999999 !important;\n  transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;\n  padding: 24px 20px !important;\n  display: flex !important;\n  flex-direction: column !important;\n  justify-content: space-between !important;\n  box-sizing: border-box !important;\n}\n\n.axela-drawer-panel.active {\n  right: 0 !important;\n}\n\n.drawer-header {\n  display: flex !important;\n  justify-content: space-between !important;\n  align-items: center !important;\n  padding-bottom: 18px !important;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;\n}\n\n.drawer-logo {\n  width: 110px !important;\n  height: auto !important;\n}\n\n.drawer-close-btn {\n  background: transparent !important;\n  border: none !important;\n  color: #94A3B8 !important;\n  font-size: 28px !important;\n  line-height: 1 !important;\n  cursor: pointer !important;\n  padding: 4px 8px !important;\n  transition: color 0.2s ease !important;\n}\n\n.drawer-close-btn:hover {\n  color: #FFFFFF !important;\n}\n\n.drawer-nav-list {\n  display: flex !important;\n  flex-direction: column !important;\n  gap: 0 !important;\n  margin: 20px 0 !important;\n  overflow-y: auto !important;\n  flex: 1 1 auto !important;\n}\n\n.drawer-nav-item {\n  color: #E2E8F0 !important;\n  font-family: 'Plus Jakarta Sans', sans-serif !important;\n  font-size: 14.5px !important;\n  font-weight: 500 !important;\n  padding: 13px 0 !important;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;\n  text-decoration: none !important;\n  transition: color 0.2s ease, padding-left 0.2s ease !important;\n}\n\n.drawer-nav-item:hover {\n  color: #2DD4BF !important;\n  padding-left: 6px !important;\n}\n\n.drawer-footer {\n  padding-top: 16px !important;\n  border-top: 1px solid rgba(255, 255, 255, 0.08) !important;\n}\n\n.drawer-cta-btn {\n  display: block !important;\n  width: 100% !important;\n  background: #168B8D !important;\n  color: #FFFFFF !important;\n  border: 1px solid rgba(45, 212, 191, 0.45) !important;\n  border-radius: 4px !important;\n  font-family: 'Plus Jakarta Sans', sans-serif !important;\n  font-size: 12px !important;\n  font-weight: 700 !important;\n  letter-spacing: 0.08em !important;\n  text-transform: uppercase !important;\n  text-decoration: none !important;\n  padding: 13px 0 !important;\n  text-align: center !important;\n  box-sizing: border-box !important;\n  transition: background 0.25s ease !important;\n}\n\n.drawer-cta-btn:hover {\n  background: #1A9D9F !important;\n}\n\n/* ==========================================================================\n   RESPONSIVE BREAKPOINT: ISOLATED MOBILE RULES (max-width: 991px)\n   ========================================================================== */\n@media (max-width: 991px) {\n  .axela-desktop-nav,\n  .axela-desktop-cta {\n    display: none !important;\n  }\n  \n  .axela-hamburger-btn {\n    display: flex !important;\n  }\n  \n  .axela-header-inner {\n    padding: 10px 18px !important;\n  }\n  \n  .axela-logo-img {\n    width: 115px !important;\n  }\n}\n</style>\n\n<script>\n(function() {\n  var hamBtn = document.getElementById('axelaHamburgerBtn');\n  var closeBtn = document.getElementById('axelaDrawerCloseBtn');\n  var overlay = document.getElementById('axelaDrawerOverlay');\n  var panel = document.getElementById('axelaDrawerPanel');\n  \n  function openDrawer() {\n    if (panel) panel.classList.add('active');\n    if (overlay) overlay.classList.add('active');\n    document.body.style.overflow = 'hidden';\n  }\n  \n  function closeDrawer() {\n    if (panel) panel.classList.remove('active');\n    if (overlay) overlay.classList.remove('active');\n    document.body.style.overflow = '';\n  }\n  \n  if (hamBtn) hamBtn.addEventListener('click', openDrawer);\n  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);\n  if (overlay) overlay.addEventListener('click', closeDrawer);\n  \n  // Close drawer when any nav link inside is tapped\n  var drawerLinks = document.querySelectorAll('.drawer-nav-item, .drawer-cta-btn');\n  for (var i = 0; i < drawerLinks.length; i++) {\n    drawerLinks[i].addEventListener('click', closeDrawer);\n  }\n})();\n</script>"

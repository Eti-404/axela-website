          "html": "<div class=\"axela-ticker-outer\">\n  <div class=\"axela-ticker-inner\">\n    <div class=\"axela-ticker-badge\">\n      <span class=\"ticker-dot\"></span>\n      <span class=\"ticker-badge-text\">LIVE MARKETS</span>\n      <span class=\"ticker-badge-pipe\">|</span>\n    </div>\n    <div class=\"axela-ticker-marquee-wrap\">\n      <div class=\"axela-ticker-marquee-track\">\n        <span class=\"tick-group\">\n          <span class=\"t-prov\">PLATTS</span> <span class=\"t-name\">LNG JKM</span> <span class=\"t-val-dn\">13.188</span> <span class=\"t-unit\">$/MMBtu</span> <span class=\"t-chg-dn\">\u25bc 2.32%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">ICE</span> <span class=\"t-name\">TTF GAS</span> <span class=\"t-val-up\">11.383</span> <span class=\"t-unit\">\u20ac/MWh</span> <span class=\"t-chg-up\">\u25b2 1.46%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">NYMEX</span> <span class=\"t-name\">HENRY HUB</span> <span class=\"t-val-dn\">1.877</span> <span class=\"t-unit\">$/MMBtu</span> <span class=\"t-chg-dn\">\u25bc 20.47%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">ARGUS</span> <span class=\"t-name\">RB COAL (API 2)</span> <span class=\"t-val-dn\">98.94</span> <span class=\"t-unit\">$/MT</span> <span class=\"t-chg-dn\">\u25bc 5.47%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">PLATTS</span> <span class=\"t-name\">IRON ORE 62% FE</span> <span class=\"t-val-up\">121.28</span> <span class=\"t-unit\">$/dmt</span> <span class=\"t-chg-up\">\u25b2 3.30%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">PLATTS</span> <span class=\"t-name\">DUBAI FATEH</span> <span class=\"t-val-dn\">77.83</span> <span class=\"t-unit\">$/bbl</span> <span class=\"t-chg-dn\">\u25bc 4.87%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">PLATTS</span> <span class=\"t-name\">DATED BRENT</span> <span class=\"t-val-up\">82.50</span> <span class=\"t-unit\">$/bbl</span> <span class=\"t-chg-up\">\u25b2 0.06%</span>\n          <span class=\"t-pipe\">|</span>\n        </span>\n        <span class=\"tick-group\">\n          <span class=\"t-prov\">PLATTS</span> <span class=\"t-name\">LNG JKM</span> <span class=\"t-val-dn\">13.188</span> <span class=\"t-unit\">$/MMBtu</span> <span class=\"t-chg-dn\">\u25bc 2.32%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">ICE</span> <span class=\"t-name\">TTF GAS</span> <span class=\"t-val-up\">11.383</span> <span class=\"t-unit\">\u20ac/MWh</span> <span class=\"t-chg-up\">\u25b2 1.46%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">NYMEX</span> <span class=\"t-name\">HENRY HUB</span> <span class=\"t-val-dn\">1.877</span> <span class=\"t-unit\">$/MMBtu</span> <span class=\"t-chg-dn\">\u25bc 20.47%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">ARGUS</span> <span class=\"t-name\">RB COAL (API 2)</span> <span class=\"t-val-dn\">98.94</span> <span class=\"t-unit\">$/MT</span> <span class=\"t-chg-dn\">\u25bc 5.47%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">PLATTS</span> <span class=\"t-name\">IRON ORE 62% FE</span> <span class=\"t-val-up\">121.28</span> <span class=\"t-unit\">$/dmt</span> <span class=\"t-chg-up\">\u25b2 3.30%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">PLATTS</span> <span class=\"t-name\">DUBAI FATEH</span> <span class=\"t-val-dn\">77.83</span> <span class=\"t-unit\">$/bbl</span> <span class=\"t-chg-dn\">\u25bc 4.87%</span>\n          <span class=\"t-pipe\">|</span>\n          <span class=\"t-prov\">PLATTS</span> <span class=\"t-name\">DATED BRENT</span> <span class=\"t-val-up\">82.50</span> <span class=\"t-unit\">$/bbl</span> <span class=\"t-chg-up\">\u25b2 0.06%</span>\n          <span class=\"t-pipe\">|</span>\n        </span>\n      </div>\n    </div>\n    <div class=\"axela-ticker-clock\">\n      <span class=\"clock-pipe\">|</span>\n      <span id=\"axela-live-clock\">01:36 AM GMT+6</span>\n    </div>\n  </div>\n</div>\n\n<style>\n/* Ticker Root Outer & Inner (1400px Max-Width Grid) */\n.axela-ticker-outer {\n  width: 100% !important;\n  background: #04070C !important;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;\n  display: flex !important;\n  justify-content: center !important;\n  align-items: center !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  box-sizing: border-box !important;\n}\n\n.axela-ticker-inner {\n  max-width: 1400px !important;\n  width: 100% !important;\n  height: 32px !important;\n  line-height: 32px !important;\n  margin: 0 auto !important;\n  padding: 0 20px !important;\n  display: flex !important;\n  flex-direction: row !important;\n  flex-wrap: nowrap !important;\n  align-items: center !important;\n  justify-content: space-between !important;\n  box-sizing: border-box !important;\n  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;\n  font-size: 11px !important;\n  overflow: hidden !important;\n  white-space: nowrap !important;\n}\n\n.axela-ticker-badge {\n  flex-shrink: 0 !important;\n  display: inline-flex !important;\n  align-items: center !important;\n  gap: 6px !important;\n  padding: 0 10px 0 0 !important;\n  height: 32px !important;\n  background: #04070C !important;\n  z-index: 5 !important;\n  white-space: nowrap !important;\n}\n\n.ticker-dot {\n  width: 6px !important;\n  height: 6px !important;\n  border-radius: 50% !important;\n  background: #1ABC9C !important;\n  box-shadow: 0 0 6px #1ABC9C !important;\n  display: inline-block !important;\n  animation: axelaPulseDot 2s infinite ease-in-out !important;\n}\n\n@keyframes axelaPulseDot {\n  0% { opacity: 1; transform: scale(1); }\n  50% { opacity: 0.35; transform: scale(0.85); }\n  100% { opacity: 1; transform: scale(1); }\n}\n\n.ticker-badge-text {\n  color: #1ABC9C !important;\n  font-weight: 700 !important;\n  letter-spacing: 0.08em !important;\n  font-size: 10.5px !important;\n}\n\n.ticker-badge-pipe {\n  color: rgba(255, 255, 255, 0.18) !important;\n  margin-left: 8px !important;\n}\n\n.axela-ticker-marquee-wrap {\n  flex: 1 1 auto !important;\n  overflow: hidden !important;\n  white-space: nowrap !important;\n  height: 32px !important;\n  display: flex !important;\n  align-items: center !important;\n  mask-image: linear-gradient(to right, transparent, black 15px, black calc(100% - 15px), transparent);\n  -webkit-mask-image: linear-gradient(to right, transparent, black 15px, black calc(100% - 15px), transparent);\n}\n\n.axela-ticker-marquee-track {\n  display: inline-flex !important;\n  align-items: center !important;\n  white-space: nowrap !important;\n  animation: axelaMarqueeLoop 36s linear infinite !important;\n}\n\n.axela-ticker-marquee-track:hover {\n  animation-play-state: paused !important;\n}\n\n@keyframes axelaMarqueeLoop {\n  0% { transform: translateX(0); }\n  100% { transform: translateX(-50%); }\n}\n\n.tick-group {\n  display: inline-flex !important;\n  align-items: center !important;\n  white-space: nowrap !important;\n}\n\n.t-prov {\n  color: #5A7F87 !important;\n  font-size: 10.5px !important;\n  font-weight: 600 !important;\n  margin-right: 5px !important;\n}\n\n.t-name {\n  color: #FFFFFF !important;\n  font-weight: 700 !important;\n  font-size: 11px !important;\n  letter-spacing: 0.02em !important;\n  margin-right: 6px !important;\n}\n\n.t-val-dn {\n  color: #EF4444 !important;\n  font-weight: 700 !important;\n  margin-right: 4px !important;\n}\n\n.t-val-up {\n  color: #1ABC9C !important;\n  font-weight: 700 !important;\n  margin-right: 4px !important;\n}\n\n.t-unit {\n  color: #64748B !important;\n  font-size: 10px !important;\n  margin-right: 5px !important;\n}\n\n.t-chg-dn {\n  color: #EF4444 !important;\n  font-weight: 700 !important;\n  font-size: 10.5px !important;\n}\n\n.t-chg-up {\n  color: #1ABC9C !important;\n  font-weight: 700 !important;\n  font-size: 10.5px !important;\n}\n\n.t-pipe {\n  color: rgba(255, 255, 255, 0.18) !important;\n  margin: 0 14px !important;\n}\n\n.axela-ticker-clock {\n  flex-shrink: 0 !important;\n  display: inline-flex !important;\n  align-items: center !important;\n  padding: 0 0 0 10px !important;\n  height: 32px !important;\n  background: #04070C !important;\n  color: #CBD5E1 !important;\n  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;\n  font-size: 11px !important;\n  font-weight: 600 !important;\n  letter-spacing: 0.04em !important;\n  z-index: 5 !important;\n  white-space: nowrap !important;\n}\n\n.clock-pipe {\n  color: rgba(255, 255, 255, 0.18) !important;\n  margin-right: 10px !important;\n}\n\n@media (max-width: 767px) {\n  .axela-ticker-inner {\n    padding: 0 10px !important;\n  }\n  .axela-ticker-clock {\n    font-size: 10px !important;\n    padding-left: 6px !important;\n  }\n  .clock-pipe {\n    margin-right: 6px !important;\n  }\n}\n</style>\n\n<script>\n(function() {\n  function updateAxelaClock() {\n    var el = document.getElementById('axela-live-clock');\n    if (!el) return;\n    var now = new Date();\n    var utc = now.getTime() + (now.getTimezoneOffset() * 60000);\n    var bd = new Date(utc + (3600000 * 6));\n    var h = bd.getHours();\n    var m = String(bd.getMinutes()).padStart(2, '0');\n    var ampm = h >= 12 ? 'PM' : 'AM';\n    h = h % 12;\n    h = h ? String(h).padStart(2, '0') : '12';\n    el.textContent = h + ':' + m + ' ' + ampm + ' GMT+6';\n  }\n  updateAxelaClock();\n  setInterval(updateAxelaClock, 1000);\n})();\n</script>"

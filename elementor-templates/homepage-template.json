                "settings": {
                  "html": "<div class=\"axela-hero-stats-wrapper\">\n  <!-- Metric 1 -->\n  <div class=\"axela-stat-row\">\n    <div class=\"axela-stat-text-side\">\n      <div class=\"stat-number-val\">20M</div>\n      <div class=\"stat-label-val\">MT MOVED IN 2025</div>\n    </div>\n    <div class=\"axela-stat-line-side\">\n      <span class=\"stat-golden-bar\"></span>\n    </div>\n  </div>\n\n  <!-- Metric 2 -->\n  <div class=\"axela-stat-row\">\n    <div class=\"axela-stat-text-side\">\n      <div class=\"stat-number-val\">70+</div>\n      <div class=\"stat-label-val\">BANKING PARTNERS</div>\n    </div>\n    <div class=\"axela-stat-line-side\">\n      <span class=\"stat-golden-bar\"></span>\n    </div>\n  </div>\n\n  <!-- Metric 3 -->\n  <div class=\"axela-stat-row\">\n    <div class=\"axela-stat-text-side\">\n      <div class=\"stat-number-val\">70+</div>\n      <div class=\"stat-label-val\">REGULATORY BODIES</div>\n    </div>\n    <div class=\"axela-stat-line-side\">\n      <span class=\"stat-golden-bar\"></span>\n    </div>\n  </div>\n</div>\n\n<style>\n.axela-hero-stats-wrapper {\n  display: flex !important;\n  flex-direction: column !important;\n  gap: 34px !important;\n  align-items: flex-end !important;\n  justify-content: center !important;\n  width: 100% !important;\n}\n\n.axela-stat-row {\n  display: flex !important;\n  flex-direction: row !important;\n  align-items: center !important;\n  justify-content: flex-end !important;\n  gap: 20px !important;\n  transition: transform 0.25s ease !important;\n}\n\n.axela-stat-row:hover {\n  transform: translateX(-3px) !important;\n}\n\n.axela-stat-text-side {\n  display: flex !important;\n  flex-direction: column !important;\n  align-items: flex-end !important;\n  text-align: right !important;\n}\n\n.stat-number-val {\n  font-family: 'Cormorant Garamond', Georgia, serif !important;\n  font-size: 52px !important;\n  font-weight: 500 !important;\n  line-height: 1 !important;\n  color: #E5A93C !important;\n  letter-spacing: -0.01em !important;\n  margin-bottom: 5px !important;\n  text-shadow: 0 0 20px rgba(229, 169, 60, 0.20) !important;\n}\n\n.stat-label-val {\n  font-family: 'Plus Jakarta Sans', -apple-system, sans-serif !important;\n  font-size: 10.5px !important;\n  font-weight: 600 !important;\n  letter-spacing: 0.16em !important;\n  text-transform: uppercase !important;\n  color: #94A3B8 !important;\n  white-space: nowrap !important;\n}\n\n.axela-stat-line-side {\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n}\n\n.stat-golden-bar {\n  display: block !important;\n  width: 1.5px !important;\n  height: 52px !important;\n  background: #E5A93C !important;\n  border-radius: 1px !important;\n  box-shadow: 0 0 6px rgba(229, 169, 60, 0.3) !important;\n}\n\n/* Mobile Stacking for Stats: Clean 3-Item Row or Centered Cards */\n@media (max-width: 991px) {\n  .axela-hero-stats-wrapper {\n    flex-direction: row !important;\n    justify-content: space-between !important;\n    align-items: center !important;\n    width: 100% !important;\n    gap: 10px !important;\n    padding: 16px 0 !important;\n    border-top: 1px solid rgba(255, 255, 255, 0.08) !important;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;\n  }\n  \n  .axela-stat-row {\n    flex: 1 1 33.33% !important;\n    justify-content: center !important;\n    gap: 10px !important;\n  }\n  \n  .axela-stat-text-side {\n    align-items: center !important;\n    text-align: center !important;\n  }\n  \n  .stat-number-val {\n    font-size: 28px !important;\n    margin-bottom: 3px !important;\n  }\n  \n  .stat-label-val {\n    font-size: 9px !important;\n    letter-spacing: 0.10em !important;\n    white-space: normal !important;\n    line-height: 1.25 !important;\n  }\n  \n  .stat-golden-bar {\n    height: 36px !important;\n    width: 1px !important;\n  }\n}\n</style>"

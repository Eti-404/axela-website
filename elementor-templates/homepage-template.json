                "elType": "widget",
                "settings": {
                  "html": "<div class=\"axela-hero-btn-row\">\n  <a href=\"#enquiry\" class=\"axela-hero-btn axela-btn-teal\">\n    <span>SUBMIT A TRADE ENQUIRY</span>\n  </a>\n  <a href=\"#services\" class=\"axela-hero-btn axela-btn-glass\">\n    <span>DISCUSS A SUPPLY REQUIREMENT</span>\n    <span class=\"btn-arrow\">&rarr;</span>\n  </a>\n  <a href=\"#investment\" class=\"axela-hero-btn axela-btn-gold\">\n    <span>EXPLORE INVESTMENT OPPORTUNITIES</span>\n    <span class=\"btn-arrow\">&rarr;</span>\n  </a>\n</div>\n\n<style>\n.axela-hero-btn-row {\n  display: flex !important;\n  flex-direction: row !important;\n  flex-wrap: nowrap !important;\n  align-items: center !important;\n  gap: 12px !important;\n  margin-top: 16px !important;\n  width: 100% !important;\n}\n\n.axela-hero-btn {\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  gap: 8px !important;\n  padding: 12px 20px !important;\n  border-radius: 3px !important;\n  font-family: 'Plus Jakarta Sans', -apple-system, sans-serif !important;\n  font-size: 11.5px !important;\n  font-weight: 700 !important;\n  letter-spacing: 0.10em !important;\n  text-transform: uppercase !important;\n  text-decoration: none !important;\n  white-space: nowrap !important;\n  flex-shrink: 0 !important;\n  transition: all 0.25s ease !important;\n  box-sizing: border-box !important;\n}\n\n.axela-btn-teal {\n  background: #168B8D !important;\n  color: #FFFFFF !important;\n  border: 1px solid rgba(45, 212, 191, 0.45) !important;\n}\n\n.axela-btn-teal:hover {\n  background: #1A9D9F !important;\n  box-shadow: 0 0 16px rgba(22, 139, 141, 0.45) !important;\n  color: #FFFFFF !important;\n}\n\n.axela-btn-glass {\n  background: rgba(255, 255, 255, 0.05) !important;\n  color: #E2E8F0 !important;\n  border: 1px solid rgba(255, 255, 255, 0.22) !important;\n  font-weight: 600 !important;\n}\n\n.axela-btn-glass:hover {\n  background: rgba(255, 255, 255, 0.12) !important;\n  border-color: rgba(255, 255, 255, 0.45) !important;\n  color: #FFFFFF !important;\n}\n\n.axela-btn-gold {\n  background: rgba(229, 169, 60, 0.08) !important;\n  color: #E5A93C !important;\n  border: 1.5px solid #E5A93C !important;\n  font-weight: 700 !important;\n}\n\n.axela-btn-gold:hover {\n  background: rgba(229, 169, 60, 0.20) !important;\n  border-color: #F5BA42 !important;\n  color: #FFD269 !important;\n  box-shadow: 0 0 16px rgba(229, 169, 60, 0.35) !important;\n}\n\n.btn-arrow {\n  font-size: 13px !important;\n  transition: transform 0.2s ease !important;\n}\n\n.axela-hero-btn:hover .btn-arrow {\n  transform: translateX(3px) !important;\n}\n\n/* Mobile Stacking: Full Width Buttons for Touch */\n@media (max-width: 991px) {\n  .axela-hero-btn-row {\n    flex-direction: column !important;\n    width: 100% !important;\n    gap: 10px !important;\n  }\n  \n  .axela-hero-btn {\n    width: 100% !important;\n    padding: 13px 16px !important;\n    font-size: 12px !important;\n    text-align: center !important;\n  }\n}\n</style>"
